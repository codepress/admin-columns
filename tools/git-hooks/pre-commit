#!/usr/bin/env bash
# tools/git-hooks/pre-commit — block commits that violate php-cs-fixer rules.
#
# Install (preserves any existing hooks):
#     ln -sf ../../tools/git-hooks/pre-commit .git/hooks/pre-commit
#
# Checks only staged PHP files, respecting the project's finder via
# --path-mode=intersection. Does not modify files; run `composer cs` to fix.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

PHP_BIN="${PHP_CS_FIXER_PHP:-php}"                          # override if php on PATH is > 8.3
FIXER="tools/php-cs-fixer/vendor/bin/php-cs-fixer"

if [ ! -f "$FIXER" ]; then
    echo "pre-commit: php-cs-fixer not installed — run 'composer cs:install'. Skipping." >&2
    exit 0
fi

files=()
while IFS= read -r file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.php')
[ "${#files[@]}" -eq 0 ] && exit 0

if ! "$PHP_BIN" "$FIXER" fix \
        --config=.php-cs-fixer.dist.php \
        --path-mode=intersection \
        --dry-run --diff --using-cache=no \
        "${files[@]}"; then
    echo >&2
    echo "pre-commit: coding-standards issues found. Fix with 'composer cs', re-stage, commit again." >&2
    exit 1
fi
