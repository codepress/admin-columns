{
    "autoload": {
        "psr-4": {
            "AC\\": "classes/"
        }
    },
    "config": {
        "autoloader-suffix": "AdminColumns",
        "platform": {
            "php": "7.4.33"
        }
    },
    "require": {
        "php-di/php-di": "^6.4"
    },
    "scripts": {
        "prefix": [
            "@composer install --working-dir=build --no-interaction",
            "@php build/app.php prefix"
        ],
        "prefix:release": [
            "@composer install --working-dir=build --no-interaction",
            "@php build/app.php prefix --no-dev"
        ],
        "post-install-cmd": [
            "@prefix"
        ],
        "post-update-cmd": [
            "@prefix"
        ],
        "cs:install": "@composer install --working-dir=tools/php-cs-fixer --no-interaction",
        "cs": "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs:check": "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff",
        "phpstan:install": "@composer install --working-dir=tools/phpstan --no-interaction",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyse --memory-limit=2G"
    }
}